-- Crear la base de datos
CREATE DATABASE IF NOT EXISTS graficacion;
USE graficacion;

-- 1. Tabla Roles (Conecta con routes/roles.js)
CREATE TABLE Roles (
    id_rol INT AUTO_INCREMENT PRIMARY KEY,
    nombre_rol VARCHAR(50) NOT NULL UNIQUE
);

-- 2. Tabla Participantes (Conecta con routes/participantes.js)
CREATE TABLE Participantes (
    id_participante INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    fecha_registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Tabla Proyectos (Conecta con routes/proyectos.js)
CREATE TABLE Proyectos (
    id_proyecto INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    descripcion TEXT,
    estado VARCHAR(50) DEFAULT 'En progreso',
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4. Tabla Intermedia: Proyecto_Participantes 
-- Permite que varios participantes trabajen en un proyecto con un rol específico
CREATE TABLE Proyecto_Participantes (
    id_proyecto INT,
    id_participante INT,
    id_rol INT,
    PRIMARY KEY (id_proyecto, id_participante),
    FOREIGN KEY (id_proyecto) REFERENCES Proyectos(id_proyecto) ON DELETE CASCADE,
    FOREIGN KEY (id_participante) REFERENCES Participantes(id_participante) ON DELETE CASCADE,
    FOREIGN KEY (id_rol) REFERENCES Roles(id_rol) ON DELETE SET NULL
);

-- 5. Tabla Analisis_Requerimientos (Conecta con routes/proceso.js)
-- Aquí se guardan las entrevistas, cuestionarios, etc.
CREATE TABLE Analisis_Requerimientos (
    id_analisis INT AUTO_INCREMENT PRIMARY KEY,
    id_proyecto INT NOT NULL,
    tipo_metodo ENUM(
        'entrevista', 'cuestionario', 'historias_usuarios', 
        'focus_group', 'observaciones', 'documentos', 
        'seguimiento_transaccional'
    ) NOT NULL,
    contenido JSON NOT NULL, -- Columna flexible
    creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_proyecto) REFERENCES Proyectos(id_proyecto) ON DELETE CASCADE
);

-- 6. Tablas de Salida (Para el Súper Prompt y la IA)
CREATE TABLE Diagramas_Generados (
    id_diagrama INT AUTO_INCREMENT PRIMARY KEY,
    id_proyecto INT NOT NULL,
    tipo_diagrama VARCHAR(50) NOT NULL,
    codigo_generado TEXT NOT NULL,
    creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_proyecto) REFERENCES Proyectos(id_proyecto) ON DELETE CASCADE
);

CREATE TABLE Prompts_Finales (
    id_prompt INT AUTO_INCREMENT PRIMARY KEY,
    id_proyecto INT NOT NULL,
    contenido_prompt TEXT NOT NULL,
    creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_proyecto) REFERENCES Proyectos(id_proyecto) ON DELETE CASCADE
);

